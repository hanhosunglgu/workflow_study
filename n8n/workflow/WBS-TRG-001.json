    {
      "parameters": {
        "jsCode": "const raw = ($input.item.json.message || '').replace(/<[^>]+>/g, '').trim();\nconst parts = raw.split(/\\s+/);\nconst keyword = parts[0] || '';\nconst param = parts.slice(1).join(' ').trim();\n\nlet command = 'unknown';\nif (keyword === '진척률') command = '진척률';\nelse if (keyword === '코드검증') command = '코드검증';\nelse if (keyword === '티켓') command = '티켓';\nelse if (keyword === '도움말') command = '도움말';\n\nreturn [{ json: { ...$input.item.json, command, param, rawMessage: raw } }];"
      },
